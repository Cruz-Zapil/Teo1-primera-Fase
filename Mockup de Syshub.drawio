        <mxCell id="5rlErsG1tYEom5-RPAib-8" parent="1" style="text;whiteSpace=wrap;html=1;fontSize=51;" value="&lt;font&gt;Mockup de Syshub&lt;/font&gt;&lt;div&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="560" x="1260" y="410" as="geometry" />
        </mxCell>
        <mxCell id="5rlErsG1tYEom5-RPAib-9" parent="1" style="text;whiteSpace=wrap;html=1;fontSize=25;" value="&lt;strong&gt;Mockup 1 — Dashboard&lt;/strong&gt; muestra el layout con sidebar de navegación, 4 tarjetas de métricas del semestre, un feed de proyectos destacados con sus tags y votaciones, actividad reciente en tiempo real, y los hilos más activos del foro." vertex="1">
          <mxGeometry height="130" width="1180" x="600" y="490" as="geometry" />
        </mxCell>
        <mxCell id="5rlErsG1tYEom5-RPAib-10" parent="1" style="text;whiteSpace=wrap;html=1;fontSize=25;" value="&lt;strong&gt;Mockup 2 — Vista de Foros (Sys-Reddit)&lt;/strong&gt; incluye un hilo expandido con sistema de upvote/downvote, la respuesta marcada como solución con badge de Auxiliar de Cátedra, respuestas anidadas con votación individual, editor de respuesta con toolbar de formato, panel lateral con categorías y ranking de contribuidores, e hilos relacionados." vertex="1">
          <mxGeometry height="80" width="1230" x="630" y="1470" as="geometry" />
        </mxCell>
        <mxCell id="5rlErsG1tYEom5-RPAib-11" parent="1" style="text;whiteSpace=wrap;html=1;fontSize=25;" value="&lt;strong&gt;Mockup 3 — Flujo de nuevo repositorio&lt;/strong&gt; es un stepper interactivo de 3 pasos que puedes navegar: paso 1 con formulario completo (título, descripción, área, curso, stack, etiquetas), paso 2 con zona de carga de archivos y lista de progreso por archivo, paso 3 con vista previa real de cómo se verá la tarjeta publicada, y pantalla de confirmación con éxito. Haz clic en los botones para navegar entre pasos." vertex="1">
          <mxGeometry height="100" width="1160" x="590" y="2590" as="geometry" />
        </mxCell>
      </root>
